{
  "name": "@dvcol/import-map-plugin",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@12.4.1",
  "description": "Vite and rollup plugin to inject import map into index.html",
  "homepage": "https://github.com/dvcol/vite-plugin-import-map",
  "bugs": "https://github.com/dvcol/vite-plugin-import-map/issues",
  "keywords": [
    "typescript",
    "library",
    "vite",
    "wite-plugin",
    "rollup",
    "rollup-plugin",
    "importmap",
    "import-map",
    "html",
    "index.html",
    "esm",
    "micro-frontend"
  ],
  "license": "MIT",
  "author": "dvcol",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvcol/vite-plugin-import-map"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">= 7"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      }
    },
    "./entry": {
      "import": "./dist/entry/import-map.entry.js",
      "require": "./dist/entry/import-map.entry.cjs",
      "types": {
        "import": "./dist/entry/import-map.entry.d.ts",
        "require": "./dist/entry/import-map.entry.d.cts"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky install",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --run",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "release": "standard-version",
    "release:changelog": "extract-changelog-release > RELEASE.md"
  },
  "dependencies": {
    "@web/rollup-plugin-html": "^4.0.0",
    "chalk": "^6.0.0",
    "globby": "^16.0.0",
    "husky": "^9.0.0",
    "prettier": "^3.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@dvcol/eslint-plugin-presets": "^1.3.10",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "extract-changelog-release": "^1.0.2",
    "jsdom": "^30.0.0",
    "standard-version": "^9.5.0",
    "tsup": "^8.0.1",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
